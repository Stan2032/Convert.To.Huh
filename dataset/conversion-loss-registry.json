      "description": "Bits per channel, and the size of the representable colour set."
    },
    {
      "id": "color_profile",
      "description": "ICC profile or colour space; determines whether colours reproduce accurately."
    },
    {
      "id": "alpha",
      "description": "Per-pixel transparency. Note the difference between a format supporting alpha and a file using it."
    },
    {
      "id": "time",
      "description": "Temporal structure: duration, frame timing, animation, synchronisation."
    },
    {
      "id": "layers",
      "description": "Independently addressable planes or objects that have not been flattened together."
    },
    {
      "id": "text_as_text",
      "description": "Whether text remains selectable, searchable and machine-readable, rather than becoming a picture of text."
    },
    {
      "id": "structure",
      "description": "Document hierarchy: headings, lists, tables, reading order."
    },
    {
      "id": "metadata",
      "description": "Descriptive and embedded data: authorship, timestamps, EXIF, GPS, comments."
    },
    {
      "id": "fonts",
      "description": "Embedded font programs, and whether glyphs render as the author intended."
    },
    {
      "id": "interactivity",
      "description": "Links, form fields, scripts, and other active behaviour."
    },
    {
      "id": "audio_channels",
      "description": "Channel count and layout, e.g. stereo or surround."
    },
    {
      "id": "sample_rate",
      "description": "Audio samples per second."
    },
    {
      "id": "bit_depth",
      "description": "Bits per audio sample."
    },
    {
      "id": "precision",
      "description": "Numeric precision of stored values, e.g. float versus integer."
    },
    {
      "id": "topology",
      "description": "Mesh connectivity: which vertices form which faces."
    },
    {
      "id": "materials",
      "description": "Surface appearance: textures, shaders, material assignments."
    },
    {
      "id": "rigging",
      "description": "Skeleton, joints, weights and animation bindings."
    },
    {
      "id": "provenance",
      "description": "Recorded history of the file's origin and prior processing."
    }
